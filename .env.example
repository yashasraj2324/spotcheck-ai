# Copy to .env and fill in. Never commit .env.

# MLflow tracking. Leave empty to log to a local sqlite:///mlflow.db.
# For Azure ML: `az ml workspace show -n <ws> -g <rg> --query mlflow_tracking_uri -o tsv`
MLFLOW_TRACKING_URI=

# Dataset provenance, logged with every run (set by scripts/register_data.py output)
DATASET_ASSET_NAME=
DATASET_ASSET_VERSION=

# Local dataset locations (override the paths in configs/*.yaml)
HAM10000_DIR=data/HAM10000

# Serving
SKIN_LESION_CHECKPOINT=checkpoints/best.pth
API_URL=http://localhost:8000

# Azure (used by infra/ scripts and scripts/register_data.py; placeholders only)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
AZURE_STORAGE_ACCOUNT=
AZURE_LOCATION=centralindia

# Optional: upload per-epoch training checkpoints to the Blob container `checkpoints`
AZURE_STORAGE_CONNECTION_STRING=

# Service principal, only needed when training outside Azure (Kaggle/Colab) and logging to Azure ML
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
